# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Kalshi (required for live trading)
# Create an API key in the Kalshi dashboard. You get a key ID (UUID) and a
# downloadable RSA private key (.pem). Save the .pem and point the path below at it.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi_key.pem
# "demo" = paper trading (recommended to start), "prod" = real money
KALSHI_ENV=demo

# Twitter API v2 (optional — real-time news stream)
TWITTER_BEARER_TOKEN=

# Telegram Bot (optional — channel monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=

# NewsAPI.org (optional — broader news coverage)
NEWSAPI_KEY=

# Pipeline Settings
DRY_RUN=true
MAX_BET_USD=25
DAILY_LOSS_LIMIT_USD=100
EDGE_THRESHOLD=0.10

# V2 Settings
# NOTE: on Kalshi, volume is measured in CONTRACTS, not USD.
MAX_VOLUME=50000
MIN_VOLUME=50
MATERIALITY_THRESHOLD=0.6
SPEED_TARGET_SECONDS=5
